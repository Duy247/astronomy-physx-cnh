Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^image_card/([A-Za-z0-9_-]+)\.php$ object.php?id=$1 [QSA,L]
    RewriteRule ^([A-Za-z0-9_-]+)\.htm$ legacy_page.php?page=$1 [QSA,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^([A-Za-z0-9_-]+)\.php$ legacy_page.php?page=$1 [QSA,L]
</IfModule>

<FilesMatch "^(?:composer\.(?:json|lock)|requirements\.txt|phpunit\.xml|\.gitattributes|\.gitignore)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://aladin.u-strasbg.fr; style-src 'self' 'unsafe-inline' https://aladin.u-strasbg.fr; img-src 'self' data: blob: https:; connect-src 'self' data: https:; worker-src 'self' blob:; frame-src https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>
